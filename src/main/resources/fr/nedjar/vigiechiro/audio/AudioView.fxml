<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import fr.nedjar.vigiechiro.audio.view.SonogramView?>
<?import fr.nedjar.vigiechiro.audio.view.SpectrogramView?>

<!--
  Vue racine du composant AudioView (pattern fx:root). Depuis l'issue #9, le contenu central est
  composé de deux sous-vues (custom controls fx:root) : <SonogramView fx:id="sonoView"/> et
  <SpectrogramView fx:id="spectroView"/>. Chacune charge son propre FXML et a son contrôleur ;
  AudioView les câble à la session via sonoView.bindTo(...) / spectroView.bindTo(...).
-->
<fx:root type="javafx.scene.layout.BorderPane"
         xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         styleClass="audio-view"
         stylesheets="@audio-view.css"
         minWidth="200" prefWidth="640" prefHeight="360">

  <top>
    <!-- FlowPane et non HBox (issue #56) : une HBox ne renvoie JAMAIS à la ligne, elle rétrécit ses
         enfants - et un Button trop étroit ellipse son texte. Le composant étant embarqué dans des
         mises en page qu'il ne choisit pas, il se retrouve à des largeurs où « Temps + » devenait
         « Temps... ». Une barre d'actions doit plier : à l'étroit, les commandes passent sur une
         seconde rangée et restent lisibles. `hgap`/`vgap` remplacent `spacing`, que FlowPane ignore. -->
    <FlowPane fx:id="toolbar" styleClass="audio-view-toolbar" alignment="CENTER_LEFT" hgap="8" vgap="6">
      <padding>
        <Insets top="6" right="6" bottom="6" left="6"/>
      </padding>
      <Button fx:id="playButton" onAction="#onTogglePlay" text="Lecture"/>
      <Button onAction="#onZoomTimeIn" text="Temps +"/>
      <Button onAction="#onZoomTimeOut" text="Temps -"/>
      <Button onAction="#onZoomFreqIn" text="Fréq. +"/>
      <Button onAction="#onZoomFreqOut" text="Fréq. -"/>
      <Label fx:id="timeLabel" text="0.00 / 0.00 s"/>
    </FlowPane>
  </top>

  <center>
    <StackPane fx:id="plotsStack">
      <!-- spacing=0 : le curseur de lecture (rouge) traverse sono et spectro de manière
           pixel-continue, sans bande sombre entre les deux. -->
      <VBox fx:id="plots" spacing="0">
        <SonogramView fx:id="sonoView"/>
        <SpectrogramView fx:id="spectroView" VBox.vgrow="ALWAYS"/>
      </VBox>

      <!-- Overlay d'erreur de chargement (issue #22) : centré au-dessus des tracés, visible
           uniquement quand le ViewModel signale une erreur (binding dans le contrôleur). -->
      <Label fx:id="errorOverlay" styleClass="audio-view-error" StackPane.alignment="CENTER"
             wrapText="true" mouseTransparent="true" managed="false" visible="false"/>
    </StackPane>
  </center>
</fx:root>
