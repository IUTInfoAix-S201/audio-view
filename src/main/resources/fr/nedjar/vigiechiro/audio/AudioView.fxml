<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<!--
  Vue du composant AudioView (pattern fx:root) : la racine est le BorderPane, et le contrôleur est
  l'instance AudioView elle-même (FXMLLoader.setRoot(this)+setController(this)). Le contrôleur câble
  les tailles (bindings), le rendu et les commandes vers le ViewModel. La feuille audio-view.css est
  appliquée par le contrôleur.
-->
<!--
  minHeight non spécifié : BorderPane calcule son min depuis le contenu, ce qui borne la hauteur du
  composant à la hauteur min de la toolbar (sono/spectro/legend ayant minHeight=0 ou étant masquables
  par binding). La toolbar reste donc toujours visible quel que soit le redimensionnement.
-->
<fx:root type="javafx.scene.layout.BorderPane"
         xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         styleClass="audio-view"
         stylesheets="@audio-view.css"
         minWidth="200" prefWidth="640" prefHeight="360">

  <top>
    <HBox fx:id="toolbar" styleClass="audio-view-toolbar" alignment="CENTER_LEFT" spacing="8">
      <padding>
        <Insets top="6" right="6" bottom="6" left="6"/>
      </padding>
      <Button fx:id="playButton" onAction="#onTogglePlay" text="Lecture"/>
      <Button onAction="#onZoomTimeIn" text="Temps +"/>
      <Button onAction="#onZoomTimeOut" text="Temps -"/>
      <Button onAction="#onZoomFreqIn" text="Fréq. +"/>
      <Button onAction="#onZoomFreqOut" text="Fréq. -"/>
      <Label fx:id="timeLabel" text="0.00 / 0.00 s"/>
    </HBox>
  </top>

  <center>
    <StackPane fx:id="plotsStack">
      <VBox fx:id="plots" spacing="2">
        <!-- Hôtes à taille minimale nulle : sinon le Canvas (non redimensionnable) bloquerait la
             réduction de la fenêtre. Tailles et positions des nœuds sont câblées par le contrôleur. -->

        <!-- Sonogramme : enveloppe min/max tracée sur Canvas (irréductible) + curseur en nœud. -->
        <Pane fx:id="sonoHost" styleClass="audio-view-plot-area" minWidth="0" minHeight="0">
          <Canvas fx:id="sonoCanvas"/>
          <Line fx:id="sonoCursor" styleClass="audio-view-cursor" managed="false"/>
        </Pane>

        <!-- Spectrogramme : image recadrée (ImageView + viewport), axes régénérés dans axisLayer,
             curseur en nœud. Vgrow ALWAYS pour qu'il prenne toute la place disponible quand le
             sonogramme est masqué (responsive, cf. issue #30). -->
        <Pane fx:id="spectroHost" styleClass="audio-view-plot-area" minWidth="0" minHeight="0"
              VBox.vgrow="ALWAYS">
          <ImageView fx:id="spectroImage" managed="false" smooth="false" pickOnBounds="false"/>
          <Pane fx:id="axisLayer" mouseTransparent="true"/>
          <Line fx:id="spectroCursor" styleClass="audio-view-cursor" managed="false"/>
        </Pane>
      </VBox>
      <!-- Légende des couleurs (remplie par le contrôleur), alignée en haut-droite. -->
      <Pane fx:id="legend" styleClass="audio-view-legend" StackPane.alignment="TOP_RIGHT"
            mouseTransparent="true"/>

      <!-- Overlay d'erreur de chargement (issue #22) : centré au-dessus des tracés, visible
           uniquement quand le ViewModel signale une erreur (binding dans le contrôleur). -->
      <Label fx:id="errorOverlay" styleClass="audio-view-error" StackPane.alignment="CENTER"
             wrapText="true" mouseTransparent="true" managed="false" visible="false"/>
    </StackPane>
  </center>
</fx:root>
