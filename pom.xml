<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>fr.nedjar.vigiechiro</groupId>
  <artifactId>audio-view</artifactId>
  <version>1.1.0</version>
  <packaging>jar</packaging>

  <name>VigieChiro Audio View</name>
  <description>Composant JavaFX sonogramme + spectrogramme pour fichiers WAV (SAE 2.01).</description>
  <url>https://github.com/IUTInfoAix-S201/audio-view</url>

  <!-- Métadonnées exigées par Maven Central (cf. profil "release" + maven-gpg-plugin). -->
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <organization>
    <name>IUT d'Aix-Marseille — SAÉ 2.01 VigieChiro PR Companion</name>
    <url>https://iut.univ-amu.fr/</url>
  </organization>

  <developers>
    <developer>
      <id>nedseb</id>
      <name>Sébastien NEDJAR</name>
      <email>sebastien.nedjar@univ-amu.fr</email>
      <organization>IUT d'Aix-Marseille</organization>
      <organizationUrl>https://iut.univ-amu.fr/</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/IUTInfoAix-S201/audio-view.git</connection>
    <developerConnection>scm:git:git@github.com:IUTInfoAix-S201/audio-view.git</developerConnection>
    <url>https://github.com/IUTInfoAix-S201/audio-view</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <javafx.version>26</javafx.version>
    <!-- Classifier JavaFX par plateforme, utilise UNIQUEMENT pour exécuter les tests.
         Surchargé par les profils plus bas (mac, mac-aarch64, windows). -->
    <javafx.platform>linux</javafx.platform>

    <!-- Late-binding de l'agent JaCoCo : prepare-agent pose l'argLine ici (propertyName), et
         surefire la réinjecte via @{jacocoArgLine}. Sans ce relais, l'argLine statique de surefire
         (options JavaFX Headless) écraserait celle de JaCoCo et viderait la couverture. Défaut vide
         pour que "mvn test" hors agent ne laisse pas un @{...} littéral. -->
    <jacocoArgLine></jacocoArgLine>

    <junit.version>6.1.1</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <testfx.version>4.0.18</testfx.version>

    <!-- Outils qualité (alignés sur les TP R2.02 / R2.03). -->
    <spotless.maven.plugin.version>3.9.0</spotless.maven.plugin.version>
    <palantir.java.format.version>2.91.0</palantir.java.format.version>
    <git.build.hook.plugin.version>3.6.0</git.build.hook.plugin.version>
    <maven.pmd.plugin.version>3.28.0</maven.pmd.plugin.version>
    <maven.enforcer.plugin.version>3.6.3</maven.enforcer.plugin.version>
    <spotbugs.maven.plugin.version>4.9.8.3</spotbugs.maven.plugin.version>
    <jacoco.maven.plugin.version>0.8.15</jacoco.maven.plugin.version>
    <pitest.maven.plugin.version>1.25.3</pitest.maven.plugin.version>
    <pitest.junit5.plugin.version>1.2.3</pitest.junit5.plugin.version>
  </properties>

  <dependencies>
    <!-- JavaFX en scope "provided" : non transitif, donc invisible pour le projet
         consommateur (le template etudiant apporte sa propre version de JavaFX et
         gere les natifs par OS via son javafx-maven-plugin).

         Le classifier ${javafx.platform} (regle par les profils OS plus bas) est
         INDISPENSABLE : les artefacts OpenJFX sans classifier sont des jars vides,
         sans module-info, ce qui casse la compilation modulaire sur une JVM qui
         n'embarque pas JavaFX. base et graphics sont declares explicitement car la
         resolution transitive ne ramenerait sinon que ces stubs vides. Cette config
         compile donc sur n'importe quel JDK 25+ (Temurin, OpenJDK, Zulu fx...), ce
         qui rend aussi le build JitPack independant du JDK propose. -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-base</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
      <scope>provided</scope>
    </dependency>

    <!-- Tests : JUnit 5 + AssertJ + TestFX -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>testfx-core</artifactId>
      <version>${testfx.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>testfx-junit5</artifactId>
      <version>${testfx.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <executions>
          <!-- L'artefact principal est modulaire (module-info). On compile en revanche
               les tests en mode classpath pour eviter les complications module-path. -->
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <useModulePath>false</useModulePath>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <!-- Headless Platform JavaFX 26 (Gluon) : plateforme Glass logicielle, en mémoire, SANS
               serveur X (plus de xvfb). Le pipeline de rendu logiciel (sw) remplace le GPU. On NE
               met PAS testfx.headless=true (il déclencherait le vieux bootstrap Monocle, absent) :
               le headless vient de glass.platform=Headless. Aligné sur les TP R2.02 / vigiechiro. -->
          <systemPropertyVariables>
            <glass.platform>Headless</glass.platform>
            <prism.order>sw</prism.order>
            <java.awt.headless>true</java.awt.headless>
            <testfx.robot>glass</testfx.robot>
          </systemPropertyVariables>
          <!-- Tests en mode classpath (useModulePath=false) : JavaFX vit dans le module non nommé,
               donc des options « add-opens / add-exports » ciblant javafx.graphics seraient des no-op
               « Unknown module ». On ne garde que @{jacocoArgLine} (agent de couverture, cf.
               jacocoArgLine) et l'accès natif du module non nommé (libs natives JavaFX). -->
          <argLine>
            @{jacocoArgLine}
            --enable-native-access=ALL-UNNAMED
          </argLine>
        </configuration>
      </plugin>

      <!-- Formatage Google Java Format (aligne sur les TP R2.02 / R2.03). Lancer
           "./mvnw spotless:apply" avant de committer ; appele automatiquement par le
           hook .githooks/pre-commit. Non attache a verify pour ne pas bloquer la CI
           sur du formatage. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.maven.plugin.version}</version>
        <configuration>
          <java>
            <palantirJavaFormat>
              <version>${palantir.java.format.version}</version>
              <style>PALANTIR</style>
              <!-- formatJavadoc=false : préserve les doc-comments Markdown Java (JEP 467,
                   syntaxe ///) que Palantir reformaterait sinon en HTML. -->
              <formatJavadoc>false</formatJavadoc>
            </palantirJavaFormat>
            <importOrder/>
            <removeUnusedImports/>
            <formatAnnotations/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
      </plugin>

      <!-- git-build-hook : configure silencieusement core.hooksPath=.githooks au
           premier ./mvnw, pour activer le pre-commit Spotless dans chaque clone sans
           action manuelle (comme les TP R2.02 / R2.03). -->
      <plugin>
        <groupId>com.rudikershaw.gitbuildhook</groupId>
        <artifactId>git-build-hook-maven-plugin</artifactId>
        <version>${git.build.hook.plugin.version}</version>
        <configuration>
          <gitConfig>
            <core.hooksPath>.githooks</core.hooksPath>
          </gitConfig>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>configure</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- PMD : analyse statique (memes regles pedagogiques que R2.03). En "verify"
           il REPORTE sans bloquer (failOnViolation=false) ; le profil quality-gate
           le rend bloquant (utilise par la CI lint). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>${maven.pmd.plugin.version}</version>
        <configuration>
          <rulesets>
            <ruleset>${project.basedir}/pmd-ruleset.xml</ruleset>
          </rulesets>
          <printFailingErrors>true</printFailingErrors>
          <failOnViolation>false</failOnViolation>
          <linkXRef>false</linkXRef>
          <targetJdk>25</targetJdk>
          <includeTests>false</includeTests>
        </configuration>
        <executions>
          <execution>
            <id>pmd-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Enforcer : rend exécutables les invariants du CLAUDE.md. Verrouille le JDK 25
           et Maven, et INTERDIT JavaFX en scope compile/runtime (doit rester provided). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven.enforcer.plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-invariants</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>org.openjfx:*:*:*:compile</exclude>
                    <exclude>org.openjfx:*:*:*:runtime</exclude>
                  </excludes>
                  <message>JavaFX doit rester en scope "provided" (jamais compile/runtime).</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- SpotBugs : analyse statique sur le bytecode, bloquant en "verify". Pertinent
           sur le code DSP (indices FFT, bit-ops, decalages signes du decodage WAV). -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>${spotbugs.maven.plugin.version}</version>
        <configuration>
          <effort>Max</effort>
          <threshold>Medium</threshold>
          <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- JaCoCo : couverture. Le gate (check) est SCOPÉ aux classes pures testables
           (Fft, Spectrogram, AudioSample) ; le rendu JavaFX d'AudioView, non testable
           raisonnablement en headless, est hors gate. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.maven.plugin.version}</version>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <!-- Pose l'argLine de l'agent dans jacocoArgLine (et non l'argLine surefire par
                   défaut), pour que surefire la compose avec les options JavaFX via @{jacocoArgLine}. -->
              <propertyName>jacocoArgLine</propertyName>
            </configuration>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-check-classes-pures</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>CLASS</element>
                  <includes>
                    <include>fr.nedjar.vigiechiro.audio.dsp.Fft</include>
                    <include>fr.nedjar.vigiechiro.audio.dsp.Spectrogram</include>
                    <include>fr.nedjar.vigiechiro.audio.dsp.AudioSample</include>
                    <include>fr.nedjar.vigiechiro.audio.render.Colormap</include>
                    <include>fr.nedjar.vigiechiro.audio.render.AxisTicks</include>
                    <include>fr.nedjar.vigiechiro.audio.dsp.AudioAnalyzer</include>
                    <include>fr.nedjar.vigiechiro.audio.playback.PlaybackModel</include>
                    <include>fr.nedjar.vigiechiro.audio.render.SpectrogramImageFactory</include>
                    <include>fr.nedjar.vigiechiro.audio.viewmodel.SonogramViewModel</include>
                    <include>fr.nedjar.vigiechiro.audio.viewmodel.SpectrogramViewModel</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- PITest : mutation testing, SCOPÉ aux classes pures. Non lié à verify (lent) :
           lancer "./mvnw test-compile pitest:mutationCoverage". Montre si les tests
           attrapent vraiment les bugs (qualité), pas seulement la couverture. -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>${pitest.maven.plugin.version}</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>${pitest.junit5.plugin.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <targetClasses>
            <param>fr.nedjar.vigiechiro.audio.dsp.Fft</param>
            <param>fr.nedjar.vigiechiro.audio.dsp.Spectrogram</param>
            <param>fr.nedjar.vigiechiro.audio.dsp.AudioSample</param>
            <param>fr.nedjar.vigiechiro.audio.render.Colormap</param>
            <param>fr.nedjar.vigiechiro.audio.render.AxisTicks</param>
            <param>fr.nedjar.vigiechiro.audio.dsp.AudioAnalyzer</param>
            <param>fr.nedjar.vigiechiro.audio.playback.PlaybackModel</param>
            <param>fr.nedjar.vigiechiro.audio.render.SpectrogramImageFactory</param>
            <param>fr.nedjar.vigiechiro.audio.viewmodel.SonogramViewModel</param>
            <param>fr.nedjar.vigiechiro.audio.viewmodel.SpectrogramViewModel</param>
          </targetClasses>
          <targetTests>
            <param>fr.nedjar.vigiechiro.audio.dsp.FftTest</param>
            <param>fr.nedjar.vigiechiro.audio.dsp.SpectrogramTest</param>
            <param>fr.nedjar.vigiechiro.audio.dsp.AudioSampleTest</param>
            <param>fr.nedjar.vigiechiro.audio.render.ColormapTest</param>
            <param>fr.nedjar.vigiechiro.audio.render.AxisTicksTest</param>
            <param>fr.nedjar.vigiechiro.audio.dsp.AudioAnalyzerTest</param>
            <param>fr.nedjar.vigiechiro.audio.playback.PlaybackModelTest</param>
            <param>fr.nedjar.vigiechiro.audio.playback.PlaybackModelToolkitTest</param>
            <param>fr.nedjar.vigiechiro.audio.render.SpectrogramImageFactoryToolkitTest</param>
            <param>fr.nedjar.vigiechiro.audio.viewmodel.SonogramViewModelTest</param>
            <param>fr.nedjar.vigiechiro.audio.viewmodel.SpectrogramViewModelTest</param>
          </targetTests>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Quality gate : PMD bloque sur violation. Active via "./mvnw -Pquality-gate verify"
         et par la CI lint. -->
    <profile>
      <id>quality-gate</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-pmd-plugin</artifactId>
            <configuration>
              <failOnViolation>true</failOnViolation>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>mac</id>
      <activation>
        <os><family>mac</family></os>
      </activation>
      <properties>
        <javafx.platform>mac</javafx.platform>
      </properties>
    </profile>
    <profile>
      <id>mac-aarch64</id>
      <activation>
        <os><family>mac</family><arch>aarch64</arch></os>
      </activation>
      <properties>
        <javafx.platform>mac-aarch64</javafx.platform>
      </properties>
    </profile>
    <profile>
      <id>windows</id>
      <activation>
        <os><family>windows</family></os>
      </activation>
      <properties>
        <javafx.platform>win</javafx.platform>
      </properties>
    </profile>

    <!-- Pipeline de publication Maven Central (issue #25). Activé via "./mvnw -Prelease deploy"
         depuis la CI (cf. .github/workflows/release.yml), quand semantic-release a tagué une
         version. Produit : jar + -sources + -javadoc, tous signés GPG ; envoi vers Sonotype
         Central via le central-publishing-maven-plugin (auto-publish).

         Prérequis utilisateur (cf. CONTRIBUTING.md) :
         - Compte Sonatype Central + namespace fr.nedjar.vigiechiro vérifié (TXT DNS).
         - Clé GPG publiée sur keys.openpgp.org.
         - Secrets GitHub : CENTRAL_USERNAME, CENTRAL_PASSWORD, GPG_PRIVATE_KEY, GPG_PASSPHRASE. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.1</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
            <configuration>
              <!-- /// JEP 467 : doclint strict refuserait. On l'assouplit ; les warnings
                   éventuels ne bloquent pas la release. -->
              <doclint>none</doclint>
              <source>25</source>
              <quiet>true</quiet>
            </configuration>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
                <configuration>
                  <!-- Passphrase passée via GPG_PASSPHRASE (settings.xml.template), mode batch. -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
