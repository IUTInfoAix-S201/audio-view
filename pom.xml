<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>fr.nedjar.vigiechiro</groupId>
  <artifactId>audio-view</artifactId>
  <version>1.1.0</version>
  <packaging>jar</packaging>

  <name>VigieChiro Audio View</name>
  <description>Composant JavaFX sonogramme + spectrogramme pour fichiers WAV (SAE 2.01).</description>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <javafx.version>25</javafx.version>
    <!-- Classifier JavaFX par plateforme, utilise UNIQUEMENT pour exécuter les tests.
         Surchargé par les profils plus bas (mac, mac-aarch64, windows). -->
    <javafx.platform>linux</javafx.platform>

    <junit.version>5.11.3</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <testfx.version>4.0.18</testfx.version>

    <!-- Outils qualité (alignés sur les TP R2.02 / R2.03). -->
    <spotless.maven.plugin.version>3.6.0</spotless.maven.plugin.version>
    <google.java.format.version>1.35.0</google.java.format.version>
    <git.build.hook.plugin.version>3.6.0</git.build.hook.plugin.version>
    <maven.pmd.plugin.version>3.28.0</maven.pmd.plugin.version>
    <maven.enforcer.plugin.version>3.5.0</maven.enforcer.plugin.version>
    <spotbugs.maven.plugin.version>4.9.8.3</spotbugs.maven.plugin.version>
    <jacoco.maven.plugin.version>0.8.14</jacoco.maven.plugin.version>
    <pitest.maven.plugin.version>1.25.3</pitest.maven.plugin.version>
    <pitest.junit5.plugin.version>1.2.3</pitest.junit5.plugin.version>
  </properties>

  <dependencies>
    <!-- JavaFX en scope "provided" : non transitif, donc invisible pour le projet
         consommateur (le template etudiant apporte sa propre version de JavaFX et
         gere les natifs par OS via son javafx-maven-plugin).

         Le classifier ${javafx.platform} (regle par les profils OS plus bas) est
         INDISPENSABLE : les artefacts OpenJFX sans classifier sont des jars vides,
         sans module-info, ce qui casse la compilation modulaire sur une JVM qui
         n'embarque pas JavaFX. base et graphics sont declares explicitement car la
         resolution transitive ne ramenerait sinon que ces stubs vides. Cette config
         compile donc sur n'importe quel JDK 25+ (Temurin, OpenJDK, Zulu fx...), ce
         qui rend aussi le build JitPack independant du JDK propose. -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-base</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
      <scope>provided</scope>
    </dependency>

    <!-- Tests : JUnit 5 + AssertJ + TestFX -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>testfx-core</artifactId>
      <version>${testfx.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>testfx-junit5</artifactId>
      <version>${testfx.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <executions>
          <!-- L'artefact principal est modulaire (module-info). On compile en revanche
               les tests en mode classpath pour eviter les complications module-path. -->
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <useModulePath>false</useModulePath>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
        <configuration>
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>

      <!-- Formatage Google Java Format (aligne sur les TP R2.02 / R2.03). Lancer
           "./mvnw spotless:apply" avant de committer ; appele automatiquement par le
           hook .githooks/pre-commit. Non attache a verify pour ne pas bloquer la CI
           sur du formatage. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.maven.plugin.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google.java.format.version}</version>
            </googleJavaFormat>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
      </plugin>

      <!-- git-build-hook : configure silencieusement core.hooksPath=.githooks au
           premier ./mvnw, pour activer le pre-commit Spotless dans chaque clone sans
           action manuelle (comme les TP R2.02 / R2.03). -->
      <plugin>
        <groupId>com.rudikershaw.gitbuildhook</groupId>
        <artifactId>git-build-hook-maven-plugin</artifactId>
        <version>${git.build.hook.plugin.version}</version>
        <configuration>
          <gitConfig>
            <core.hooksPath>.githooks</core.hooksPath>
          </gitConfig>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>configure</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- PMD : analyse statique (memes regles pedagogiques que R2.03). En "verify"
           il REPORTE sans bloquer (failOnViolation=false) ; le profil quality-gate
           le rend bloquant (utilise par la CI lint). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>${maven.pmd.plugin.version}</version>
        <configuration>
          <rulesets>
            <ruleset>${project.basedir}/pmd-ruleset.xml</ruleset>
          </rulesets>
          <printFailingErrors>true</printFailingErrors>
          <failOnViolation>false</failOnViolation>
          <linkXRef>false</linkXRef>
          <targetJdk>25</targetJdk>
          <includeTests>false</includeTests>
        </configuration>
        <executions>
          <execution>
            <id>pmd-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Enforcer : rend exécutables les invariants du CLAUDE.md. Verrouille le JDK 25
           et Maven, et INTERDIT JavaFX en scope compile/runtime (doit rester provided). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven.enforcer.plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-invariants</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>org.openjfx:*:*:*:compile</exclude>
                    <exclude>org.openjfx:*:*:*:runtime</exclude>
                  </excludes>
                  <message>JavaFX doit rester en scope "provided" (jamais compile/runtime).</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- SpotBugs : analyse statique sur le bytecode, bloquant en "verify". Pertinent
           sur le code DSP (indices FFT, bit-ops, decalages signes du decodage WAV). -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>${spotbugs.maven.plugin.version}</version>
        <configuration>
          <effort>Max</effort>
          <threshold>Medium</threshold>
          <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- JaCoCo : couverture. Le gate (check) est SCOPÉ aux classes pures testables
           (Fft, Spectrogram, AudioSample) ; le rendu JavaFX d'AudioView, non testable
           raisonnablement en headless, est hors gate. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.maven.plugin.version}</version>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-check-classes-pures</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>CLASS</element>
                  <includes>
                    <include>fr.nedjar.vigiechiro.audio.Fft</include>
                    <include>fr.nedjar.vigiechiro.audio.Spectrogram</include>
                    <include>fr.nedjar.vigiechiro.audio.AudioSample</include>
                    <include>fr.nedjar.vigiechiro.audio.Colormap</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- PITest : mutation testing, SCOPÉ aux classes pures. Non lié à verify (lent) :
           lancer "./mvnw test-compile pitest:mutationCoverage". Montre si les tests
           attrapent vraiment les bugs (qualité), pas seulement la couverture. -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>${pitest.maven.plugin.version}</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>${pitest.junit5.plugin.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <targetClasses>
            <param>fr.nedjar.vigiechiro.audio.Fft</param>
            <param>fr.nedjar.vigiechiro.audio.Spectrogram</param>
            <param>fr.nedjar.vigiechiro.audio.AudioSample</param>
            <param>fr.nedjar.vigiechiro.audio.Colormap</param>
          </targetClasses>
          <targetTests>
            <param>fr.nedjar.vigiechiro.audio.FftTest</param>
            <param>fr.nedjar.vigiechiro.audio.SpectrogramTest</param>
            <param>fr.nedjar.vigiechiro.audio.AudioSampleTest</param>
            <param>fr.nedjar.vigiechiro.audio.ColormapTest</param>
          </targetTests>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Quality gate : PMD bloque sur violation. Active via "./mvnw -Pquality-gate verify"
         et par la CI lint. -->
    <profile>
      <id>quality-gate</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-pmd-plugin</artifactId>
            <configuration>
              <failOnViolation>true</failOnViolation>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>mac</id>
      <activation>
        <os><family>mac</family></os>
      </activation>
      <properties>
        <javafx.platform>mac</javafx.platform>
      </properties>
    </profile>
    <profile>
      <id>mac-aarch64</id>
      <activation>
        <os><family>mac</family><arch>aarch64</arch></os>
      </activation>
      <properties>
        <javafx.platform>mac-aarch64</javafx.platform>
      </properties>
    </profile>
    <profile>
      <id>windows</id>
      <activation>
        <os><family>windows</family></os>
      </activation>
      <properties>
        <javafx.platform>win</javafx.platform>
      </properties>
    </profile>
  </profiles>
</project>
