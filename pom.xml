<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>fr.iutaix.vigiechiro</groupId>
  <artifactId>audio-view</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>VigieChiro Audio View</name>
  <description>Composant JavaFX sonogramme + spectrogramme pour fichiers WAV (SAE 2.01).</description>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <javafx.version>25</javafx.version>
    <!-- Classifier JavaFX par plateforme, utilise UNIQUEMENT pour exécuter les tests.
         Surchargé par les profils plus bas (mac, mac-aarch64, windows). -->
    <javafx.platform>linux</javafx.platform>

    <junit.version>5.11.3</junit.version>
    <assertj.version>3.26.3</assertj.version>
    <testfx.version>4.0.18</testfx.version>
  </properties>

  <dependencies>
    <!-- JavaFX en scope "provided" : non transitif, donc invisible pour le projet
         consommateur (le template etudiant apporte sa propre version de JavaFX et
         gere les natifs par OS via son javafx-maven-plugin).

         Le classifier ${javafx.platform} (regle par les profils OS plus bas) est
         INDISPENSABLE : les artefacts OpenJFX sans classifier sont des jars vides,
         sans module-info, ce qui casse la compilation modulaire sur une JVM qui
         n'embarque pas JavaFX. base et graphics sont declares explicitement car la
         resolution transitive ne ramenerait sinon que ces stubs vides. Cette config
         compile donc sur n'importe quel JDK 25+ (Temurin, OpenJDK, Zulu fx...), ce
         qui rend aussi le build JitPack independant du JDK propose. -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-base</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
      <scope>provided</scope>
    </dependency>

    <!-- Tests : JUnit 5 + AssertJ + TestFX -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>testfx-core</artifactId>
      <version>${testfx.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>testfx-junit5</artifactId>
      <version>${testfx.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <executions>
          <!-- L'artefact principal est modulaire (module-info). On compile en revanche
               les tests en mode classpath pour eviter les complications module-path. -->
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <useModulePath>false</useModulePath>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>

      <!-- Formatage Google Java Format (aligne sur la convention R2.02 / Spotless).
           Lancer "mvn spotless:apply" avant de committer. La verification n'est pas
           attachee a la phase verify pour ne pas bloquer une CI sur du formatage. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>2.43.0</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>1.24.0</version>
            </googleJavaFormat>
            <importOrder/>
            <removeUnusedImports/>
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>mac</id>
      <activation>
        <os><family>mac</family></os>
      </activation>
      <properties>
        <javafx.platform>mac</javafx.platform>
      </properties>
    </profile>
    <profile>
      <id>mac-aarch64</id>
      <activation>
        <os><family>mac</family><arch>aarch64</arch></os>
      </activation>
      <properties>
        <javafx.platform>mac-aarch64</javafx.platform>
      </properties>
    </profile>
    <profile>
      <id>windows</id>
      <activation>
        <os><family>windows</family></os>
      </activation>
      <properties>
        <javafx.platform>win</javafx.platform>
      </properties>
    </profile>
  </profiles>
</project>
